    64                          ; ------------------------------------------------------------------------------
    65                          ; P1: disk rom or basic rom
    66                          
    67                          A4010	EQU	04010H		; DSKIO
    68                          A401F	EQU	0401FH		; MTOFF
    69                          BASENT  EQU     04022H		; Start DiskBASIC
    70                          A4043	EQU	04043H		; EXTBIO handler DOS2
    71                          A4049	EQU	04049H		; H.TIMI handler
    72                          ERROR   EQU     0406FH          ; BASIC error
    73                          READYR  EQU     0409BH          ; restart BASIC
    74                          NTSTOP  EQU     04173H          ; execute statement
    75                          LINKER  EQU     04253H          ; recalculate linepointers
    76                          NEWSTT  EQU     04601H          ; execution loop
    77                          CHRGTR  EQU     04666H          ; CHRGTR
    78                          FLTLIN  EQU     046FFH          ; convert to SNG
    79                          INTID2  EQU     04756H          ; evaluate word operand and check for 0-32767 range
    80                          FINPRT  EQU     04AFFH          ; output back to screen
    81                          FRMEQL  EQU     04C5FH          ; evaluate =expression
    82                          FRMEVL  EQU     04C64H          ; evaluate expression
    83                          DOCNVF  EQU     0517AH          ; convert DAC to other type
    84                          GETIN2  EQU     0520FH          ; evaluate integer operand
    85                          GTBYTC  EQU     0521BH          ; evaluate next byte operand
    86                          GETBYT  EQU     0521CH          ; evaluate byte operand
    87                          CONINT  EQU     0521FH          ; convert to byte
    88                          JPFOUT  EQU     0537BH          ; convert DAC to text, unformatted (JPFOUT is not an offical name)
    89                          GETUIN  EQU     0542FH          ; evaluate address operand
    90                          GETUI   EQU     05432H          ; convert address to integer
    91                          SCCPTR  EQU     054F7H          ; convert pointers to linenumbers
    92                          GETYPR  EQU     05597H          ; GETYPR
    93                          PTRGET  EQU     05EA4H          ; get address of variable
    94                          STRINI  EQU     06627H          ; allocate temp string
    95                          GETSPA  EQU     0668EH          ; allocate string space
    96                          FRESTR  EQU     067D0H          ; free temporary string
    97                          FILEVL  EQU     06A0EH          ; evaluate filespecification
    98                          FILIDX  EQU     06A6DH          ; get i/o channel pointer
    99                          OPNFIL  EQU     06AFAH          ; open i/o channel
   100                          CLSFIL  EQU     06B24H          ; close i/o channel
   101                          CLSALL  EQU     06C1CH          ; close all i/o channels
   102                          NOSKCR  EQU     06E41H          ; resume character putback routine
   103                          BSAVE   EQU     06E92H          ; start of BSAVE routine
   104                          BLOAD   EQU     06EC6H          ; start of BLOAD routine
   105                          BLDFIN  EQU     06EF4H          ; finish BLOAD
   106                          ADRGET  EQU     06F0BH          ; evaluate address operand (BLOAD/SAVE)
   107                          M6F0B   EQU     06F0BH          ; evaluate address operand (BLOAD/SAVE) (DOS1)
   108                          PARDEV  EQU     06F15H          ; skip strong cassette devicecheck
   109                          CRDONZ  EQU     07323H          ; newline to OUTDO if not at start of line
   110                          CRDO    EQU     07328H          ; newline to OUTDO
   111                          M739A   EQU     0739AH          ; quit loading & start (headloop/executing)
   112                          M7D17   EQU     07D17H          ; continue start of MSX-BASIC without executing BASIC programs in ROM
   113                          M7D2F   EQU     07D2FH          ; address initialize BASIC screen
   114                          M7D31   EQU     07D31H          ; BASIC initscreen (without INITXT & CNSDFG)
   115                          M7DE9   EQU     07DE9H          ; start MSX-BASIC program in ROM
   116                          M7E14   EQU     07E14H          ; start MSX-BASIC program in ROM (DOS1)
