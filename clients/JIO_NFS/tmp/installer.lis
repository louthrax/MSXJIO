   660                          ; ------------------------------------------------------------------------------
   661                          ; Structure information
   662                          
   663                          ; FCB structure
   664                          
   665                          ; +0	DR	drive			drive
   666                          ; +1,8	F1-F8	file name		file name
   667                          ; +9,3	T1-T3	filetype		filetype
   668                          ; +12	EX	extent			extent (low byte)
   669                          ; +13	S1	reserved		fileattribute
   670                          ; +14	S2	reserved		extent high byte / record size low byte (block)
   671                          ; +15	RC	record count in extent	record count in extent / record size high byte (block)
   672                          ; +16,4	AL	allocation		Filesize
   673                          ; +20,4	AL	allocation		volume-id
   674                          ; +24	AL	allocation
   675                          ; +25	AL	allocation
   676                          ; +26,2	AL	allocation		start cluster
   677                          ; +28,2	AL	allocation		current cluster
   678                          ; +30,2	AL	allocation		current relative cluster
   679                          ; +32	CR	record in extent	record in extent
   680                          ; +33,3	R0-R2	random access record	random access record
   681                          ; +36	R4	not used		random access record when record size <64
   682                          
   683                          
   684                          ; FIB structure
   685                          
   686                          ; +0		fib indicator (0FFH)
   687                          ; +1,13		file name as an ASCIIZ string
   688                          ; +14		file attributes byte
   689                          ; +15,2		time of last modification
   690                          ; +17,2		date of last modification
   691                          ; +19,2		start cluster
   692                          ; +21,4		file size
   693                          ; +25		logical drive
   694                          ; +26,4		disk serial (if on disk)
   695                          ; +28,2		pointer to device jump table (if device)
   696                          ; +30		device flags
   697                          ; +32,2		pointer to drive table
   698                          ; +34,2		current directory sector
   699                          ; +36		current directory entry in sector
   700                          ; +37,2		cluster number of parent directory
   701                          ; +39,2		start cluster of file
   702                          ; +41,2		current cluster of file
   703                          ; +43,2		current relative cluster of file
   704                          ; +45,4		current file position
   705                          ; +49		open mode
   706                          ; +50
   707                          
   708                          
   709                          ; drive table structure
   710                          
   711                          ; +0		slot id interface
   712                          ; +1		offset (relative to 4000H) of jumptable of interface driver
   713                          ; +2,2		pointer to Drive Parameter Block (DPB) of drive
   714                          ; +4		flags
   715                          ; +5		flags
   716                          ; +6		drive id used within interface driver
   717                          ; +7
   718                          ; +8		drivename
   719                          ; +9		1/10 seconds+2 that disk cannot be changed (0 = init, 1 = error)
   720                          ; +10		cluster mask
   721                          ; +11		cluster shift
   722                          ; +12,2		number of reserved sectors (bootarea)
   723                          ; +14		number of FAT's
   724                          ; +15		remainder of directory entries (no whole sector)
   725                          ; +16		number of directorysectors (whole sectors)
   726                          ; +17		number of sectors per FAT
   727                          ; +18,2		first sector of rootdirectory
   728                          ; +20,2		first sector of data area
   729                          ; +22,2		number of clusters+1 on disk
   730                          ; +24		dirty flag Bit 0 = 1, when on a DOS2 disk file(s) have been deleted
   731                          ; +25,4		volume serial number (0FFFFFFFFH if none)
   732                          ; +29		media descriptor byte of disk
   733                          ; +30,2		starting cluster of current directory (bit 15 = 1 means root)
   734                          ; +32,64	current directory (ASCIIZ) without "drive:\" prefix
   735                          
   736                          
   737                          ; device entry
   738                          
   739                          ; +0,2		pointer to jump table
   740                          ; +2
   741                          ; +8		device flags
   742                          ; +9,11		device name
