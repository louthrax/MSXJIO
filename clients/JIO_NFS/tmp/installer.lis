installer.asm:
     1                          	INCLUDE "msx.inc"
msx.inc:
     1                          ; msx.inc
     2                          ;
     3                          ; MSX constants and definitions for DOS1 and DOS2
     4                          ; ------------------------------------------------------------------------------
     5                          
     6                          BOT16K	EQU	0C000H			; lower of 16 KB RAM
     7                          BOT32K	EQU	08000H			; lower of 32 KB RAM
     8                          BOOTSZ	EQU	256			; maximum size of MSX bootloader in bootsector
     9                          TMPSTK	EQU	BOT16K+BOOTSZ+256	; location of temporary stack
    10                          TBASE	EQU	00100H			; start of MSX-DOS
    11                          
    12                          ; ------------------------------------------------------------------------------
    13                          ; P0: BIOS or BDOS 2 kernel
    14                          
    15                          WBOOT  	EQU     0000H
    16                          KBDOS   EQU     0005H
    17                          RDSLT   EQU     000CH
    18                          WRSLT	EQU	0014H
    19                          CALSLT  EQU     001CH
    20                          ENASLT  EQU     0024H
    21                          IDBYT0  EQU     002BH
    22                          IDBYT2  EQU     002DH
