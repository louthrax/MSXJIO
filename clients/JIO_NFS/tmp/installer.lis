   598                          _NRDY	EQU	0FCH		; not ready
   599                          _VERFY	EQU	0FBH		; verify error
   600                          _DATA	EQU	0FAH		; data error
   601                          _RNF	EQU	0F9H		; sector not found
   602                          _WPROT	EQU	0F8H		; write protected disk
   603                          _UFORM	EQU	0F7H		; unformatted disk
   604                          _NDOS	EQU	0F6H		; not a DOS disk
   605                          _WDISK	EQU	0F5H		; wrong disk
   606                          _WFILE	EQU	0F4H		; wrong disk for file
   607                          _SEEK	EQU	0F3H		; seek error
   608                          _IFAT	EQU	0F2H		; bad file allocation table
   609                          _NOUPB	EQU	0F1H		;
   610                          _IFORM	EQU	0F0H		; cannot format this drive
   611                          
   612                          _INTER	EQU	0DFH		; internal error
   613                          _NORAM	EQU	0DEH		; not enough memory
   614                          _IBDOS	EQU	0DCH		; invalid BDOS call
   615                          _IDRV	EQU	0DBH		; invalid drive
   616                          _IFNM	EQU	0DAH		; invalid filename
   617                          _IPATH	EQU	0D9H		; invalid pathname
   618                          _PLONG	EQU	0D8H		; pathname too long
   619                          _NOFIL	EQU	0D7H		; file not found
   620                          _NODIR	EQU	0D6H		; directory not found
   621                          _DRFUL	EQU	0D5H		; boot directory full
   622                          _DKFUL	EQU	0D4H		; disk full
   623                          _DUPF	EQU	0D3H		; duplicate filename
   624                          _DIRE	EQU	0D2H		; invalid directory move
   625                          _FILRO	EQU	0D1H		; read only file
   626                          _DIRNE	EQU	0D0H		; directory not empty
   627                          _IATTR	EQU	0CFH		; invalid attributes
   628                          _DOT	EQU	0CEH		; invalid . or .. operation
   629                          _SYSX	EQU	0CDH		; system file exists
