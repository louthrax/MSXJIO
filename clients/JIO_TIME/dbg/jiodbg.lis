jiodbg.asm:
   279                          INCLUDE "../../JIO_NFS/receive.asm"
../../JIO_NFS/receive.asm:
     1                          bJIOReceive:
     2  0272  d5                	push	de
     3                          
     4  0273  110000            	ld	de,0
     5                          
     6  0276  2b                	dec	hl
     7  0277  dd210000          	ld	ix,0
     8  027b  dd39              	add	ix,sp
     9  027d  3ad401            	ld	a,(_JioPort)	; 0xFF = joystick port 2, 0xFE = joystick port 1 (PSG), else I/O register of the cartridge
    10  0280  4f                	ld	c,a
    11  0281  fefe              	cp	0xfe
    12  0283  3004              	jr	nc,ReceivePSG
    13  0285  ed78              	in	a,(c)	; JIO cartridge: bit 0
    14  0287  1818              	jr	ReceiveLevel
    15                          ReceivePSG:
    16  0289  0ea2              	ld	c,0xa2
    17  028b  3e0f              	ld	a,15	; PSG register 15: bit 6 = joystick port selected (0 = port 1)
    18  028d  d3a0              	out	(0xa0),a
    19  028f  dba2              	in	a,(0xa2)
    20  0291  2804              	jr	z,ReceiveJoy1	; Z (CP 0xFE above, flags kept): joystick port 1
    21  0293  f640              	or	64	; joystick port 2
    22  0295  1802              	jr	ReceiveSelect
    23                          ReceiveJoy1:
    24  0297  e6bf              	and	0xbf
    25                          ReceiveSelect:
    26  0299  d3a1              	out	(0xa1),a
    27  029b  3e0e              	ld	a,14	; PSG register 14 (pin 1 of the joystick port selected)
    28  029d  d3a0              	out	(0xa0),a
    29  029f  dba2              	in	a,(0xa2)
    30                          ReceiveLevel:
    31  02a1  f601              	or	1
    32  02a3  eafa02            	jp	pe,HeaderPE
    33                          ;________________________________________________________________________________________________________________________________
    34                          
    35                          HeaderPO:
    36  02a6  1b                	dec	de	;  7
    37  02a7  7a                	ld	a,d	;  5
    38  02a8  b3                	or	e	;  5
    39  02a9  284c              	jr	z,RxTimeOut 	;  8
