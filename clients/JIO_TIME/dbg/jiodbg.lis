   129  0261  ed59                                              out	(c),e	; -1
   130  0263  0f                                                rrca
   131  0264  30d2                                              jr	nc,TRANSMIT06
   132  0266  00                                                nop
   133                          
   134                          TRANSMIT16:
   135  0267  ed59                                              out	(c),e	; -0
