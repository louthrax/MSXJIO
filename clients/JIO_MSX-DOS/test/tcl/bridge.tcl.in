# openMSX bridge: the serial routines of the JIO kernel are intercepted and
# forwarded to mockserver.py (TCP), the ROM "waiting for server" handshake is skipped.
# Generated from bridge.tcl.in by 0_RunTests.sh (addresses from the ROM map file).
#
# JIO_DRIVES (environment): number of JIO drives reported by the handshake (hybrid ROM),
# 0 simulates [ESC] (no server). Default 1.
# JIO_HANDSHAKE (environment): if not empty, the handshake is not skipped (COMMAND_DRIVE_INFO and _LOGIN
# of the driver, sent to the mock server like the commands of DSKIO).
set jio_drives [expr {[info exists ::env(JIO_DRIVES)] ? $::env(JIO_DRIVES) : 1}]
set mock_port  [expr {[info exists ::env(MOCK_PORT)] ? $::env(MOCK_PORT) : 9876}]

set sock [socket 127.0.0.1 $mock_port]
fconfigure $sock -translation binary -buffering none -blocking 1

# Check bytes at address (so the BIOS at the same address as the kernel is ignored)
proc sig {addr bytes} {
    set i 0
    foreach b $bytes {
        if {[peek [expr {($addr + $i) & 0xFFFF}]] != $b} { return 0 }
        incr i
    }
    return 1
}

# Return from the intercepted routine
proc do_ret {} {
    set sp [reg sp]
    reg pc [expr {[peek $sp] | ([peek [expr {($sp + 1) & 0xFFFF}]] << 8)}]
    reg sp [expr {($sp + 2) & 0xFFFF}]
}

# RFS_TX: HL = data, BC = size
proc rfs_tx {} {
    set hl [reg hl]
    set n [reg bc]
    set data ""
    for {set i 0} {$i < $n} {incr i} {
        append data [binary format c [peek [expr {($hl + $i) & 0xFFFF}]]]
    }
    puts -nonewline $::sock [binary format a1s T $n]
    puts -nonewline $::sock $data
    flush $::sock
    do_ret
}

# J_RX1: HL = buffer, DE = size, returns A = 1 received / 0 time-out
proc rfs_rx {} {
    set hl [reg hl]
    set n [reg de]
    puts -nonewline $::sock [binary format a1s R $n]
    flush $::sock
    binary scan [read $::sock 1] c status
    if {$status == 1} {
        binary scan [read $::sock $n] cu* bytes
        set i 0
        foreach b $bytes {
            poke [expr {($hl + $i) & 0xFFFF}] $b
            incr i
        }
        reg a 1
    } else {
        reg a 0
    }
    do_ret
}

# Serial routines of the driver (handshake and DSKIO): vJIOTransmit DE = data, BC = size,
# bJIOReceive DE = buffer, BC = size
proc drv_tx {} {
    reg hl [reg de]
    rfs_tx
}
proc drv_rx {} {
    reg hl [reg de]
    reg de [reg bc]
    rfs_rx
}

debug set_bp @RFS_TX@ {[sig @RFS_TX@ {0x78 0xB1 0xC8 0xD9}]} { rfs_tx }
debug set_bp @J_RX1@ {[sig @J_RX1@ {0xD5 0x11 0x00 0x00 0x2B}]} { rfs_rx }
debug set_bp @vJIOTransmit@ {[sig @vJIOTransmit@ {0xD9 0xC5 0xD5 0xD9}]} { drv_tx }
debug set_bp @bJIOReceive@ {[sig @bJIOReceive@ {0x62 0x6B 0x50 0x59}]} { drv_rx }
# skipped handshake: W_DRIVES = JIO drives, W_RFS = directories served
if {![info exists ::env(JIO_HANDSHAKE)] || $::env(JIO_HANDSHAKE) eq ""} {
    debug set_bp @DRIVES_Retry@ {[sig @DRIVES_Retry@ {0x3E 0x07 0xCD}]} {
        poke [expr {([reg ix] + 2) & 0xFFFF}] $::jio_drives
        poke [expr {([reg ix] + 7) & 0xFFFF}] [expr {$::jio_drives ? 1 : 0}]
        reg pc @DRIVES_Exit@
    }
}
