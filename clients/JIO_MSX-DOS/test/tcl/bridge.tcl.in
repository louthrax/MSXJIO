# openMSX bridge: the serial routines of the JIO kernel are intercepted and
# forwarded to mockserver.py (TCP), the ROM "waiting for server" handshake is skipped.
# Generated from bridge.tcl.in by 0_RunTests.sh (addresses from the ROM map file).
#
# JIO_DRIVES (environment): number of JIO drives reported by the handshake (MSX-DOS 2 ROM),
# 0 simulates [ESC] (no server). Default 1.
# JIO_HANDSHAKE (environment): if not empty, the handshake is not skipped (COMMAND_DRIVE_INFO and _LOGIN
# of the driver, sent to the mock server like the commands of DSKIO).
# JIO_AUTORETRY (environment): if not empty, "Auto retry" flag of the server in the skipped handshake.
set jio_drives [expr {[info exists ::env(JIO_DRIVES)] ? $::env(JIO_DRIVES) : 1}]
set mock_port  [expr {[info exists ::env(MOCK_PORT)] ? $::env(MOCK_PORT) : 9876}]

set sock [socket 127.0.0.1 $mock_port]
fconfigure $sock -translation binary -buffering none -blocking 1

# Check bytes at address (so the BIOS at the same address as the kernel is ignored)
proc sig {addr bytes} {
    set i 0
    foreach b $bytes {
        if {[peek [expr {($addr + $i) & 0xFFFF}]] != $b} { return 0 }
        incr i
    }
    return 1
}

# Return from the intercepted routine
proc do_ret {} {
    set sp [reg sp]
    reg pc [expr {[peek $sp] | ([peek [expr {($sp + 1) & 0xFFFF}]] << 8)}]
    reg sp [expr {($sp + 2) & 0xFFFF}]
}

# J_TXSEG (RFS_TX, request sent again by RFS_RX): HL = data, BC = size
proc rfs_tx {} {
    set hl [reg hl]
    set n [reg bc]
    set data ""
    for {set i 0} {$i < $n} {incr i} {
        append data [binary format c [peek [expr {($hl + $i) & 0xFFFF}]]]
    }
    puts -nonewline $::sock [binary format a1s T $n]
    puts -nonewline $::sock $data
    flush $::sock
    do_ret
}

# J_RX1: HL = buffer, DE = size, returns A = 1 received / 0 time-out
proc rfs_rx {} {
    set hl [reg hl]
    set n [reg de]
    puts -nonewline $::sock [binary format a1s R $n]
    flush $::sock
    binary scan [read $::sock 1] c status
    if {$status == 1} {
        binary scan [read $::sock $n] cu* bytes
        set i 0
        foreach b $bytes {
            poke [expr {($hl + $i) & 0xFFFF}] $b
            incr i
        }
        reg a 1
    } else {
        reg a 0
    }
    do_ret
}

# Serial routines of the driver (handshake and DSKIO): vJIOTransmit DE = data, BC = size,
# bJIOReceive DE = buffer, BC = size
proc drv_tx {} {
    reg hl [reg de]
    rfs_tx
}
proc drv_rx {} {
    reg hl [reg de]
    reg de [reg bc]
    rfs_rx
}

debug set_bp @J_TXSEG@ {[sig @J_TXSEG@ {0xD9 0xC5 0xD5 0xD9}]} { rfs_tx }
debug set_bp @J_RX1@ {[sig @J_RX1@ {0xD5 0x11 0x00 0x00 0x2B}]} { rfs_rx }
debug set_bp @vJIOTransmit@ {[sig @vJIOTransmit@ {0xD9 0xC5 0xD5 0xD9}]} { drv_tx }
debug set_bp @bJIOReceive@ {[sig @bJIOReceive@ {0x62 0x6B 0x50 0x59}]} { drv_rx }
# Serial routines of a tool (TOOL_TX, TOOL_RX environment: addresses from its map file):
# vJIOTransmit HL = data, DE = size, bJIOReceive HL = buffer, DE = size
proc tool_tx {} {
    reg bc [reg de]
    rfs_tx
}
if {[info exists ::env(TOOL_TX)] && $::env(TOOL_TX) ne ""} {
    debug set_bp $::env(TOOL_TX) "\[sig $::env(TOOL_TX) {0x42 0x4B 0xD9 0xC5}\]" { tool_tx }
    debug set_bp $::env(TOOL_RX) "\[sig $::env(TOOL_RX) {0xD5 0x11 0x00 0x00 0x2B}\]" { rfs_rx }
}

# Resident stub of JIO.COM (clients/JIO_NFS), copied to HIMSAV (F349H) when installed: the serial routines
# are intercepted when the BDOS hook (F37AH) is written. NFS_TX, NFS_RX (environment): offsets in the stub.
set nfs_done 0
if {[info exists ::env(NFS_TX)] && $::env(NFS_TX) ne ""} {
    debug set_watchpoint write_mem 0xF37A {} {
        # the hook is also written at boot: only when the driver is found at HIMSAV
        set base [peek16 0xF349]
        set tx [expr {($base + $::env(NFS_TX)) & 0xFFFF}]
        set rx [expr {($base + $::env(NFS_RX)) & 0xFFFF}]
        if {!$::nfs_done && [sig $tx {0x42 0x4B 0xD9 0xC5}] && [sig $rx {0xD5 0x11 0x00 0x00 0x2B}]} {
            set ::nfs_done 1
            debug set_bp $tx "\[sig $tx {0x42 0x4B 0xD9 0xC5}\]" { tool_tx }
            debug set_bp $rx "\[sig $rx {0xD5 0x11 0x00 0x00 0x2B}\]" { rfs_rx }
        }
    }
}

# skipped handshake: W_DRIVES = JIO drives, W_RFS = directories served, reset of the server (sent by the driver)
if {![info exists ::env(JIO_HANDSHAKE)] || $::env(JIO_HANDSHAKE) eq ""} {
    debug set_bp @DRIVES_Retry@ {[sig @DRIVES_Retry@ {0x3E 0x07 0xCD}]} {
        poke [expr {([reg ix] + 2) & 0xFFFF}] $::jio_drives
        poke [expr {([reg ix] + 7) & 0xFFFF}] [expr {$::jio_drives ? 1 : 0}]
        if {[info exists ::env(JIO_AUTORETRY)] && $::env(JIO_AUTORETRY) ne ""} {
            poke [expr {([reg ix] + 3) & 0xFFFF}] 8
        }
        if {$::jio_drives} {
            puts -nonewline $::sock [binary format a1s T 6]
            puts -nonewline $::sock [binary format a3ccc JIO 0 22 0x1D]
            flush $::sock
        }
        reg pc @DRIVES_Exit@
    }
}

# JIO_CART (environment): JIO cartridge ROM, detection of the port of the cartridge (not emulated) -> W_PORT = 30H
if {[info exists ::env(JIO_CART)] && $::env(JIO_CART) ne ""} {
    debug set_bp @JioDetect@ {[peek @JioDetect@] == 0xDD && [peek [expr {@JioDetect@ + 1}]] == 0x7E} {
        poke [expr {([reg ix] + 8) & 0xFFFF}] 0x30
        do_ret
    }
}
